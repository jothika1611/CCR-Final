# =========================================================================
# CCR Compliance Agent - Environment Configuration Template
# =========================================================================
# Copy this file to '.env' and populate the secrets to run the application.
# E.g., cp .env.example .env

# --- Qdrant Vector DB Configuration ---
# Set to 'localhost' for bare-metal or 'qdrant' for docker-compose configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Optional: Set Qdrant Cloud API key if using cloud DB hosting
QDRANT_API_KEY=

# --- Local Embedding Model ---
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# --- Environment & Log Settings ---
ENV=development
LOG_LEVEL=info

# --- LLM API Configuration ---
# Required for full RAG advice; if left blank, system falls back to mock retrieval answers.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
